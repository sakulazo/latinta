# Publishable API key del backend Medusa. Requerida para que el storefront funcione.
# Se crea en el admin de Medusa: Settings > API Key Management.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL del servidor Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# URL interna del backend para SSR/middleware (en Docker: http://backend:9000).
# No lleva prefijo NEXT_PUBLIC_, asi que nunca se expone al navegador.
MEDUSA_BACKEND_URL=

# Codigo de pais por defecto de la region (region "Europe" incluye es, fr, de, it...)
NEXT_PUBLIC_DEFAULT_REGION=es

# URL base del storefront (para generar URLs absolutas)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Clave publica de Stripe (opcional, Fase 2)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 (opcional, solo deploy en Medusa Cloud)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

NODE_ENV=development
