# Variables opcionales para `docker compose` (dev con contenedores).
#
# Copia este fichero a `.env` en la raiz para sobreescribir los valores por
# defecto de compose.yaml. `.env` esta ignorado por git.
#
#   cp .env.example .env
#
# Ninguna de estas variables es obligatoria: compose.yaml trae defaults de dev.

# --- Puertos publicados en el host ---
# OJO: si cambias STOREFRONT_PORT (p. ej. porque el 8000 esta ocupado por otra
# app), actualiza tambien NEXT_PUBLIC_BASE_URL, STORE_CORS y AUTH_CORS mas
# abajo. El navegador llama al backend con Origin http://localhost:<puerto>, y
# el login/registro de cliente usa /auth (AUTH_CORS).
POSTGRES_PORT=5432
BACKEND_PORT=9000
STOREFRONT_PORT=8000

# --- Credenciales de PostgreSQL (contenedor) ---
POSTGRES_DB=latinta
POSTGRES_USER=latinta
POSTGRES_PASSWORD=latinta

# --- Usuario admin que se crea automaticamente al arrancar ---
ADMIN_EMAIL=admin@latinta.local
ADMIN_PASSWORD=Latinta2026!

# --- Secretos del backend (cambiar en produccion) ---
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# --- CORS del backend (deben incluir el puerto publicado del storefront) ---
# STORE_CORS cubre store/*; AUTH_CORS cubre /auth/* (login/registro de cliente).
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# --- Storefront ---
# URL que usa el NAVEGADOR (puerto publicado del backend)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# URL publica del propio storefront (debe coincidir con STOREFRONT_PORT)
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=es
# Vacio = se toma la key generada por el seed del backend (recomendado en dev)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
